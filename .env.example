# Copy to .env to override defaults (docker compose reads .env automatically).
# Never put credentials in this file or commit .env.

# Host port for the gateway (bound to 127.0.0.1 only)
GATEWAY_PORT=8080

# local | simulated | cloud   (cloud is disabled until Phase 3+ and needs explicit opt-in)
SETU_MODE=local
SETU_LOG_LEVEL=INFO

# Gateway behaviour
SETU_CALL_MODE=parallel          # parallel | sequential
SETU_TIMEOUT_MS=800              # per-attempt timeout, 10..10000
SETU_OUTER_DEADLINE_MS=3000      # hard bound per order, 100..10000, must be >= timeout
