# Copy to .env to override defaults (docker compose reads .env automatically).
# Never put credentials in this file or commit .env.

# Host ports (bound to 127.0.0.1 only)
GATEWAY_PORT=8080
CONTROLLER_PORT=8090

# local | simulated | cloud
#   local      no injected link delay (environment labels are still reported, marked simulated)
#   simulated  inject configured link delays between environments
#   cloud      real-provider adapters; additionally needs SETU_ALLOW_CLOUD_OPERATIONS=yes
SETU_MODE=local
SETU_LOG_LEVEL=INFO

# Seed for retry backoff jitter (empty = random). Set it for reproducible experiments.
SETU_RANDOM_SEED=

# How often the gateway polls the controller for placement changes (200..60000 ms)
SETU_POLL_INTERVAL_MS=2000

# Placement, routing policies and timeouts are configured in configs/placement.yaml,
# environments and link delays in configs/environments.yaml.

# Real-provider adapters (optional; leave unset to keep them "not_configured").
# Credentials are NEVER set here: adapters will use the provider's standard credential chain.
# SETU_AWS_REGION=
# SETU_AWS_EXECUTION_ROLE_ARN=
# SETU_AWS_INFRASTRUCTURE_ROLE_ARN=
# SETU_AZURE_SUBSCRIPTION_ID=
# SETU_AZURE_RESOURCE_GROUP=
# SETU_AZURE_LOCATION=
# SETU_AZURE_CONTAINERAPPS_ENVIRONMENT=
# SETU_GCP_PROJECT_ID=
# SETU_GCP_REGION=
